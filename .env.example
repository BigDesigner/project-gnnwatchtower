# ==============================================================================
# GNNwatchtower - Çevre Değişkenleri Örnek Dosyası (.env.example)
# Bu dosya genel repoya aktarılır; bu nedenle ASLA gerçek token, şifre veya
# müşteri IP / sunucu bilgisi YAZMAYINIZ!
# Gerçek değerler için bu dosyayı kopyalayarak '.env' oluşturun.
# ==============================================================================

# Sistem ve Port Yapılandırması
SERVER_PORT=3800
GIN_MODE=release

# Güvenlik ve Kimlik Doğrulama
TLS_ENABLED=true
BIND_ADDRESS=127.0.0.1
# TLS_CERT_FILE=/path/to/trusted-cert.pem
# TLS_KEY_FILE=/path/to/private-key.pem

# Kayıtlı cihaz izleme
DEFAULT_CHECK_INTERVAL=15

# Bildirim Kanalları (Opsiyonel - UI üzerinden de girilebilir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@yourdomain.com
BREVO_RECIPIENT_EMAIL=
